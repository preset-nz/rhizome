{
  "title": "Pick a map's aspect",
  "why": "A computed preset on the map kind: the state is a ratio, the setter keeps the long edge, and a near match still counts as current.",
  "steps": [
    "new",
    {
      "edit": {
        "label": "Realm",
        "ops": [
          {
            "op": "add",
            "parent": "/realms",
            "type": "realm",
            "name": "west"
          }
        ]
      }
    },
    {
      "run": {
        "id": "map.add",
        "payload": {
          "to": "/realms/west",
          "name": "north"
        }
      }
    },
    {
      "run": {
        "id": "layer.add",
        "payload": {
          "to": "/realms/west/north",
          "name": "hills"
        }
      }
    },
    {
      "names": {
        "at": "/realms/west/north"
      }
    },
    {
      "names": {
        "at": "/realms/west/north/hills"
      }
    },
    {
      "current": {
        "at": "/realms/west/north"
      }
    },
    {
      "run": {
        "id": "preset.apply",
        "payload": {
          "at": "/realms/west/north",
          "preset": {
            "catalogue": "16x9"
          }
        }
      }
    },
    {
      "current": {
        "at": "/realms/west/north"
      }
    },
    {
      "edit": {
        "label": "Nudge",
        "ops": [
          {
            "op": "set",
            "at": "/realms/west/north",
            "key": "map.size",
            "value": [
              800.0,
              452.0
            ]
          }
        ]
      }
    },
    {
      "current": {
        "at": "/realms/west/north"
      }
    },
    {
      "run": {
        "id": "preset.apply",
        "payload": {
          "at": "/realms/west/north/hills",
          "preset": {
            "catalogue": "square"
          }
        }
      }
    },
    {
      "run": {
        "id": "edit.undo",
        "payload": {}
      }
    },
    {
      "run": {
        "id": "edit.undo",
        "payload": {}
      }
    },
    {
      "current": {
        "at": "/realms/west/north"
      }
    }
  ]
}
