{
  "title": "Choose a palette theme for a realm and a map",
  "why": "A theme is a shared choice, never written onto a node. A layer resolves it from its map, else its realm, else the built-in fallback. The choice is saved.",
  "steps": [
    "new",
    {
      "edit": {
        "label": "Realm",
        "ops": [
          {
            "op": "add",
            "parent": "/realms",
            "type": "realm",
            "name": "west"
          }
        ]
      }
    },
    {
      "run": {
        "id": "map.add",
        "payload": {
          "to": "/realms/west",
          "name": "north"
        }
      }
    },
    {
      "run": {
        "id": "layer.add",
        "payload": {
          "to": "/realms/west/north",
          "name": "hills"
        }
      }
    },
    {
      "resolve": {
        "kind": "palette",
        "at": "/realms/west/north/hills"
      }
    },
    {
      "run": {
        "id": "theme.follow",
        "payload": {
          "kind": "palette",
          "at": "/realms/west",
          "theme": "night"
        }
      }
    },
    {
      "resolve": {
        "kind": "palette",
        "at": "/realms/west/north/hills"
      }
    },
    {
      "run": {
        "id": "theme.follow",
        "payload": {
          "kind": "palette",
          "at": "/realms/west/north",
          "theme": "tide"
        }
      }
    },
    {
      "resolve": {
        "kind": "palette",
        "at": "/realms/west/north/hills"
      }
    },
    {
      "run": {
        "id": "theme.follow",
        "payload": {
          "kind": "palette",
          "at": "/realms/west/north"
        }
      }
    },
    {
      "resolve": {
        "kind": "palette",
        "at": "/realms/west/north/hills"
      }
    },
    {
      "run": {
        "id": "theme.follow",
        "payload": {
          "kind": "palette",
          "at": "/realms/west/north/hills",
          "theme": "night"
        }
      }
    },
    {
      "save_as": "/atlas/west"
    },
    "reopen",
    {
      "resolve": {
        "kind": "palette",
        "at": "/realms/west/north/hills"
      }
    }
  ]
}
